    "Profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
