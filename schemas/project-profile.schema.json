    "Decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "intent_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "selected_approach": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
