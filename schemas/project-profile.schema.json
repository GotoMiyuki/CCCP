        "non_goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          },
          "minItems": 0
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          },
          "minItems": 1
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          },
          "minItems": 0
        },
        "expected_behavior": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          },
          "minItems": 0
        },
        "verification_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Clause"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "decision_id",
        "objective",
        "scope",
        "constraints",
        "non_goals",
        "acceptance_criteria",
        "invariants",
        "expected_behavior",
        "verification_criteria"
      ],
      "additionalProperties": false
    },
    "Delegation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
