    "Discovery": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "base_commit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
