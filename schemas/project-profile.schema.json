          ]
        },
        "working_tree_status": {
          "type": "string",
          "enum": [
            "clean",
            "dirty",
            "not_git"
          ]
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
