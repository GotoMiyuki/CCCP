        "role": {
          "type": "string",
          "enum": [
            "human",
            "chatgpt",
            "codex",
            "bridge",
            "repository"
          ]
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "Intent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "objective"
      ],
      "additionalProperties": false
    },
    "Proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "intent_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
