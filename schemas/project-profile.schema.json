        "architecture_observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "reusable_implementations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "test_status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "test_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "context_conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "repository",
        "base_commit",
        "working_tree_status",
        "changed_files",
        "related_files",
        "architecture_observations",
        "reusable_implementations",
        "test_status",
        "test_evidence",
        "context_conflicts",
        "observed_at",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "ImplementationReport": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "specification_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "discovery_fingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
